<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">

    <!-- ================================================= -->
    <!-- PHYSICS                                            -->
    <!-- ================================================= -->
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"      name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system"      name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"          name="gz::sim::systems::Imu"/>

    <!-- ================================================= -->
    <!-- SCENE & LIGHTING                                  -->
    <!-- ================================================= -->
    <scene>
      <ambient>0.60 0.61 0.64 1.0</ambient>
      <background>0.75 0.79 0.83 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Primary Overhead Sun -->
    <light name="main_sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.88 0.87 0.85 1.0</diffuse>
      <specular>0.28 0.28 0.28 1.0</specular>
      <direction>-0.2 0.15 -1.0</direction>
    </light>

    <!-- Warm Fill Bay Lights -->
    <light name="bay_n" type="point">
      <pose>-3.0 5.0 5.5 0 0 0</pose>
      <diffuse>0.50 0.49 0.47 1.0</diffuse>
      <attenuation><range>18</range><constant>0.4</constant><linear>0.05</linear></attenuation>
    </light>
    <light name="bay_s" type="point">
      <pose>3.0 -4.0 5.5 0 0 0</pose>
      <diffuse>0.50 0.49 0.47 1.0</diffuse>
      <attenuation><range>18</range><constant>0.4</constant><linear>0.05</linear></attenuation>
    </light>

    <!-- Wall Industrial Floodlights (Centered in wall bays at X = +-2.5m) -->
    <light name="wall_light_n1" type="point">
      <pose>-2.5 9.78 2.30 0 0 0</pose>
      <diffuse>0.38 0.38 0.35 1.0</diffuse>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.08</linear></attenuation>
    </light>
    <light name="wall_light_n2" type="point">
      <pose>2.5 9.78 2.30 0 0 0</pose>
      <diffuse>0.38 0.38 0.35 1.0</diffuse>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.08</linear></attenuation>
    </light>
    <light name="wall_light_s1" type="point">
      <pose>-2.5 -9.78 2.30 0 0 0</pose>
      <diffuse>0.38 0.38 0.35 1.0</diffuse>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.08</linear></attenuation>
    </light>
    <light name="wall_light_s2" type="point">
      <pose>2.5 -9.78 2.30 0 0 0</pose>
      <diffuse>0.38 0.38 0.35 1.0</diffuse>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.08</linear></attenuation>
    </light>

    <!-- ================================================= -->
    <!-- FLOOR — Concrete with Grid Tile Lines              -->
    <!-- ================================================= -->
    <model name="warehouse_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor_link">
        <collision name="col">
          <geometry><box><size>20.0 20.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <!-- Base Concrete Slab — slightly darker industrial grey -->
        <visual name="slab">
          <geometry><box><size>20.0 20.0 0.1</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.59 1.0</ambient>
            <diffuse>0.63 0.65 0.67 1.0</diffuse>
            <specular>0.10 0.10 0.10 1.0</specular>
          </material>
        </visual>

        <!-- === CONCRETE TILE GRID LINES (5m x 5m panels) === -->
        <!-- Horizontal lines at Y = -5, 0, +5, -->
        <visual name="grid_h1"><pose>0 -5.0 0.052 0 0 0</pose><geometry><box><size>20.0 0.03 0.002</size></box></geometry><material><ambient>0.62 0.63 0.65 1</ambient><diffuse>0.68 0.69 0.71 1</diffuse></material></visual>
        <visual name="grid_h2"><pose>0 0.0 0.052 0 0 0</pose><geometry><box><size>20.0 0.03 0.002</size></box></geometry><material><ambient>0.62 0.63 0.65 1</ambient><diffuse>0.68 0.69 0.71 1</diffuse></material></visual>
        <visual name="grid_h3"><pose>0 5.0 0.052 0 0 0</pose><geometry><box><size>20.0 0.03 0.002</size></box></geometry><material><ambient>0.62 0.63 0.65 1</ambient><diffuse>0.68 0.69 0.71 1</diffuse></material></visual>
        <!-- Vertical lines at X = -10, -5, 0, +5, +10 -->
        <visual name="grid_v1"><pose>-5.0 0 0.052 0 0 0</pose><geometry><box><size>0.03 20.0 0.002</size></box></geometry><material><ambient>0.62 0.63 0.65 1</ambient><diffuse>0.68 0.69 0.71 1</diffuse></material></visual>
        <visual name="grid_v2"><pose>0.0 0 0.052 0 0 0</pose><geometry><box><size>0.03 20.0 0.002</size></box></geometry><material><ambient>0.62 0.63 0.65 1</ambient><diffuse>0.68 0.69 0.71 1</diffuse></material></visual>
        <visual name="grid_v3"><pose>5.0 0 0.052 0 0 0</pose><geometry><box><size>0.03 20.0 0.002</size></box></geometry><material><ambient>0.62 0.63 0.65 1</ambient><diffuse>0.68 0.69 0.71 1</diffuse></material></visual>

        <!-- === GREEN SAFETY NAVIGATION LANES === -->
        <!-- Aisle 1 upper/lower -->
        <visual name="lane_a1_t"><pose>0 9.1 0.055 0 0 0</pose><geometry><box><size>18.4 0.09 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <visual name="lane_a1_b"><pose>0 5.9 0.055 0 0 0</pose><geometry><box><size>18.4 0.09 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <!-- Aisle 2 upper/lower -->
        <visual name="lane_a2_t"><pose>0 4.5 0.055 0 0 0</pose><geometry><box><size>18.4 0.09 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <visual name="lane_a2_b"><pose>0 0.0 0.055 0 0 0</pose><geometry><box><size>18.4 0.09 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <!-- Aisle 3 upper/lower -->
        <visual name="lane_a3_t"><pose>0 -1.4 0.055 0 0 0</pose><geometry><box><size>18.4 0.09 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        
        <!-- Cross-corridor vertical lanes -->
        <visual name="lane_cv_l"><pose>-1.4 0 0.055 0 0 0</pose><geometry><box><size>0.09 18.2 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <visual name="lane_cv_r"><pose>1.4 0 0.055 0 0 0</pose><geometry><box><size>0.09 18.2 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <!-- Outer bypass lanes -->
        <visual name="lane_bp_w"><pose>-8.2 0 0.055 0 0 0</pose><geometry><box><size>0.09 18.2 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
        <visual name="lane_bp_e"><pose>8.2 0 0.055 0 0 0</pose><geometry><box><size>0.09 18.2 0.002</size></box></geometry><material><ambient>0.04 0.52 0.22 1</ambient><diffuse>0.06 0.68 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- PERIMETER WALLS WITH YELLOW SKIRTING              -->
    <!-- ================================================= -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.0 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.0 0.15 2.5</size></box></geometry><material><ambient>0.40 0.43 0.46 1</ambient><diffuse>0.50 0.53 0.57 1</diffuse></material></visual>
        <visual name="skirt"><pose>0 -0.08 -1.15 0 0 0</pose><geometry><box><size>20.0 0.025 0.22</size></box></geometry><material><ambient>0.88 0.68 0.04 1</ambient><diffuse>0.96 0.76 0.06 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -10 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20.0 0.15 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>20.0 0.15 2.5</size></box></geometry><material><ambient>0.40 0.43 0.46 1</ambient><diffuse>0.50 0.53 0.57 1</diffuse></material></visual>
        <visual name="skirt"><pose>0 0.08 -1.15 0 0 0</pose><geometry><box><size>20.0 0.025 0.22</size></box></geometry><material><ambient>0.88 0.68 0.04 1</ambient><diffuse>0.96 0.76 0.06 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>10.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 20.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 20.0 2.5</size></box></geometry><material><ambient>0.40 0.43 0.46 1</ambient><diffuse>0.50 0.53 0.57 1</diffuse></material></visual>
        <visual name="skirt"><pose>-0.08 0 -1.15 0 0 0</pose><geometry><box><size>0.025 20.0 0.22</size></box></geometry><material><ambient>0.88 0.68 0.04 1</ambient><diffuse>0.96 0.76 0.06 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-10.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 20.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 20.0 2.5</size></box></geometry><material><ambient>0.40 0.43 0.46 1</ambient><diffuse>0.50 0.53 0.57 1</diffuse></material></visual>
        <visual name="skirt"><pose>0.08 0 -1.15 0 0 0</pose><geometry><box><size>0.025 20.0 0.22</size></box></geometry><material><ambient>0.88 0.68 0.04 1</ambient><diffuse>0.96 0.76 0.06 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================= -->
    <!-- STRUCTURAL WALL PILLAR COLUMNS (every ~5m)         -->
    <!-- Industrial I-beam columns, anthracite steel        -->
    <!-- ================================================= -->
    <!-- North wall pillars -->
    <model name="pillar_n_l"><static>true</static><pose>-5.0 9.85 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.20 0.25 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_n_r"><static>true</static><pose>5.0 9.85 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.20 0.25 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_n_c"><static>true</static><pose>0.0 9.85 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.20 0.25 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <!-- South wall pillars -->
    <model name="pillar_s_l"><static>true</static><pose>-5.0 -9.85 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.20 0.25 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_s_r"><static>true</static><pose>5.0 -9.85 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.20 0.25 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_s_c"><static>true</static><pose>0.0 -9.85 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.20 0.25 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <!-- East wall pillars -->
    <model name="pillar_e_n"><static>true</static><pose>9.85 5.00 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.25 0.20 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_e_s"><static>true</static><pose>9.85 -5.00 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.25 0.20 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_e_c"><static>true</static><pose>9.85 0.0 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.25 0.20 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <!-- West wall pillars -->
    <model name="pillar_w_n"><static>true</static><pose>-9.85 5.00 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.25 0.20 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_w_s"><static>true</static><pose>-9.85 -5.00 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.25 0.20 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>
    <model name="pillar_w_c"><static>true</static><pose>-9.85 0.0 1.25 0 0 0</pose><link name="link"><visual name="vis"><geometry><box><size>0.25 0.20 2.5</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.24 0.26 0.28 1</diffuse></material></visual></link></model>

    <!-- Wall-Mounted Industrial LED Lighting Fixtures (Centered in wall bays at X = +-2.5m) -->
    <!-- North Wall Fixtures -->
    <model name="fixture_wall_n1"><static>true</static><pose>-2.5 9.92 2.35 0 0 0</pose>
      <link name="link">
        <visual name="bracket"><pose>0 -0.06 0 0 0 0</pose><geometry><box><size>0.12 0.12 0.08</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="lamp"><pose>0 -0.14 -0.02 0.3 0 0</pose><geometry><box><size>0.40 0.14 0.06</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="led_strip"><pose>0 -0.14 -0.05 0.3 0 0</pose><geometry><box><size>0.36 0.10 0.01</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.95 0.95 0.85 1</emissive></material></visual>
      </link></model>
    <model name="fixture_wall_n2"><static>true</static><pose>2.5 9.92 2.35 0 0 0</pose>
      <link name="link">
        <visual name="bracket"><pose>0 -0.06 0 0 0 0</pose><geometry><box><size>0.12 0.12 0.08</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="lamp"><pose>0 -0.14 -0.02 0.3 0 0</pose><geometry><box><size>0.40 0.14 0.06</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="led_strip"><pose>0 -0.14 -0.05 0.3 0 0</pose><geometry><box><size>0.36 0.10 0.01</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.95 0.95 0.85 1</emissive></material></visual>
      </link></model>
    <!-- South Wall Fixtures -->
    <model name="fixture_wall_s1"><static>true</static><pose>-2.5 -9.92 2.35 0 0 3.14159</pose>
      <link name="link">
        <visual name="bracket"><pose>0 -0.06 0 0 0 0</pose><geometry><box><size>0.12 0.12 0.08</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="lamp"><pose>0 -0.14 -0.02 0.3 0 0</pose><geometry><box><size>0.40 0.14 0.06</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="led_strip"><pose>0 -0.14 -0.05 0.3 0 0</pose><geometry><box><size>0.36 0.10 0.01</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.95 0.95 0.85 1</emissive></material></visual>
      </link></model>
    <model name="fixture_wall_s2"><static>true</static><pose>2.5 -9.92 2.35 0 0 3.14159</pose>
      <link name="link">
        <visual name="bracket"><pose>0 -0.06 0 0 0 0</pose><geometry><box><size>0.12 0.12 0.08</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="lamp"><pose>0 -0.14 -0.02 0.3 0 0</pose><geometry><box><size>0.40 0.14 0.06</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="led_strip"><pose>0 -0.14 -0.05 0.3 0 0</pose><geometry><box><size>0.36 0.10 0.01</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>1.0 1.0 0.9 1</diffuse><emissive>0.95 0.95 0.85 1</emissive></material></visual>
      </link></model>

    <!-- ================================================= -->
    <!-- INDUSTRIAL RACK SHELVING (NW, NE, SW, SE)         -->
    <!-- ================================================= -->
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_NW1</name>
      <pose>-4.8 7.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_NE1</name>
      <pose>4.8 7.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_NW2</name>
      <pose>-4.8 3.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_NE2</name>
      <pose>4.8 3.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_SW2</name>
      <pose>-4.8 1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_SE2</name>
      <pose>4.8 1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_SW1</name>
      <pose>-4.8 -3.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://shelf</uri>
      <name>shelf_rack_SE1</name>
      <pose>4.8 -3.0 0 0 0 0</pose>
    </include>

    <!-- ================================================= -->
    <!-- LOGISTICS PROPS                                    -->
    <!-- ================================================= -->
    <include>
      <uri>model://pallet_stack</uri>
      <name>pallet_tower_1</name>
      <pose>-5.2 -7.3 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pallet_stack</uri>
      <name>pallet_tower_2</name>
      <pose>5.2 8.75 0 0 0 0</pose>
    </include>
    <!-- Extra scattered box near NW aisle entrance -->
    <include>
      <uri>model://pallet_stack</uri>
      <name>pallet_tower_3</name>
      <pose>-8.0 5.25 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://dumpster</uri>
      <name>green_dumpster_container</name>
      <pose>-2.8 -7.3 0 0 0 0</pose>
    </include>

    <!-- ================================================= -->
    <!-- INTERSECTION I1 & I2 — PROMINENT CONFLICT ZONE          -->
    <!-- ================================================= -->

    <!-- Intersection I1 -->
    <model name="intersection_I1_marker">
      <static>true</static>
      <pose>0 5.2 0.005 0 0 0</pose>
      <link name="link">
        <!-- Bright contrast base zone -->
        <visual name="marker_zone">
          <geometry><box><size>2.7 2.7 0.005</size></box></geometry>
          <material><ambient>0.82 0.83 0.84 1.0</ambient><diffuse>0.90 0.91 0.92 1.0</diffuse></material>
        </visual>

        <!-- Yellow outer frame -->
