<?xml version="1.0"?>
<sdf version="1.9">
  <model name="amr_green">
    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>15.0</mass>
        <inertia><ixx>0.3625</ixx><iyy>0.5</iyy><izz>0.7625</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.60 0.50 0.20</size></box></geometry>
      </collision>

      <!-- Main Chassis Body — GREEN -->
      <visual name="chassis_main">
        <geometry><box><size>0.60 0.48 0.18</size></box></geometry>
        <material>
          <ambient>0.05 0.45 0.15 1.0</ambient>
          <diffuse>0.08 0.60 0.22 1.0</diffuse>
          <specular>0.4 0.5 0.4 1.0</specular>
        </material>
      </visual>
      <visual name="top_deck">
        <pose>0 0 0.095 0 0 0</pose>
        <geometry><box><size>0.56 0.46 0.015</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1.0</ambient><diffuse>0.14 0.14 0.16 1.0</diffuse></material>
      </visual>
      <visual name="bumper">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><box><size>0.62 0.52 0.06</size></box></geometry>
        <material><ambient>0.08 0.08 0.10 1.0</ambient><diffuse>0.12 0.12 0.15 1.0</diffuse></material>
      </visual>
      <visual name="front_led">
        <pose>0.299 0 0.02 0 0 0</pose>
        <geometry><box><size>0.01 0.32 0.032</size></box></geometry>
        <material><ambient>0.2 0.9 0.3 1.0</ambient><diffuse>0.3 1.0 0.4 1.0</diffuse></material>
      </visual>
      <visual name="rear_led">
        <pose>-0.299 0 0.02 0 0 0</pose>
        <geometry><box><size>0.01 0.32 0.032</size></box></geometry>
        <material><ambient>0.9 0.1 0.1 1.0</ambient><diffuse>1.0 0.15 0.15 1.0</diffuse></material>
      </visual>
      <!-- Side Accent Stripes — Light Green -->
      <visual name="stripe_left">
        <pose>0 0.242 0.01 0 0 0</pose>
        <geometry><box><size>0.40 0.005 0.04</size></box></geometry>
        <material><ambient>0.5 1.0 0.5 1.0</ambient><diffuse>0.6 1.0 0.6 1.0</diffuse></material>
      </visual>
      <visual name="stripe_right">
        <pose>0 -0.242 0.01 0 0 0</pose>
        <geometry><box><size>0.40 0.005 0.04</size></box></geometry>
        <material><ambient>0.5 1.0 0.5 1.0</ambient><diffuse>0.6 1.0 0.6 1.0</diffuse></material>
      </visual>
      <!-- "B" ID Marker on Top -->
      <visual name="id_marker">
        <pose>0.10 0 0.104 0 0 0</pose>
        <geometry><box><size>0.16 0.16 0.005</size></box></geometry>
        <material><ambient>1.0 1.0 1.0 1.0</ambient><diffuse>1.0 1.0 1.0 1.0</diffuse></material>
      </visual>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on><update_rate>50</update_rate><visualize>false</visualize><topic>imu_b</topic>
      </sensor>
      <sensor name="chassis_contact_sensor" type="contact">
        <always_on>1</always_on><update_rate>30</update_rate>
        <contact><collision>chassis_collision</collision></contact>
        <topic>amr_b_contact</topic>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.25 0.10 -1.57079632679 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.00406</ixx><iyy>0.00406</iyy><izz>0.0075</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1.0</ambient><diffuse>0.18 0.18 0.20 1.0</diffuse></material></visual>
      <visual name="hubcap"><pose>0 0 0.026 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1.0</ambient><diffuse>0.7 0.7 0.75 1.0</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.25 0.10 -1.57079632679 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.00406</ixx><iyy>0.00406</iyy><izz>0.0075</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.05</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1.0</ambient><diffuse>0.18 0.18 0.20 1.0</diffuse></material></visual>
      <visual name="hubcap"><pose>0 0 -0.026 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.005</length></cylinder></geometry><material><ambient>0.6 0.6 0.65 1.0</ambient><diffuse>0.7 0.7 0.75 1.0</diffuse></material></visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="caster">
      <pose>-0.20 0 0.05 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2><slip1>1.0</slip1><slip2>1.0</slip2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.05</radius></sphere></geometry><material><ambient>0.2 0.2 0.2 1.0</ambient><diffuse>0.3 0.3 0.3 1.0</diffuse></material></visual>
    </link>
    <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>

    <link name="lidar_link">
      <pose>0.14 0 0.26 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="housing"><geometry><cylinder><radius>0.055</radius><length>0.045</length></cylinder></geometry><material><ambient>0.08 0.08 0.10 1.0</ambient><diffuse>0.12 0.12 0.15 1.0</diffuse></material></visual>
      <visual name="scanner_eye"><pose>0 0 0.01 0 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.02</length></cylinder></geometry><material><ambient>0.0 0.7 0.9 1.0</ambient><diffuse>0.0 0.85 1.0 1.0</diffuse></material></visual>
      <collision name="lidar_collision"><geometry><cylinder><radius>0.055</radius><length>0.045</length></cylinder></geometry></collision>
      <sensor name="lidar_2d" type="gpu_lidar">
        <always_on>1</always_on><update_rate>15</update_rate><visualize>true</visualize>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
          <range><min>0.10</min><max>10.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <topic>amr_b/scan</topic>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.50</wheel_separation><wheel_radius>0.10</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>amr_b/cmd_vel</topic><odom_topic>amr_b/odom</odom_topic>
      <tf_topic>amr_b/tf</tf_topic>
      <frame_id>amr_b/odom</frame_id><child_frame_id>amr_b/base_link</child_frame_id>
      <max_linear_velocity>1.2</max_linear_velocity><min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity><min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>
  </model>
</sdf>
