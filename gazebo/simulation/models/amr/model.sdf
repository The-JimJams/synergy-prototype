<?xml version="1.0"?>
<sdf version="1.9">
  <model name="amr">
    <!-- ============================= -->
    <!-- CHASSIS (BASE LINK)           -->
    <!-- Dimensions: 0.60m x 0.50m x 0.20m -->
    <!-- ============================= -->
    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.3625</ixx>
          <iyy>0.5000</iyy>
          <izz>0.7625</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Single streamlined collision geometry for ultra-high FPS -->
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.60 0.50 0.20</size>
          </box>
        </geometry>
      </collision>

      <!-- ============================================ -->
      <!-- INDUSTRIAL AMR VISUAL STYLING                -->
      <!-- ============================================ -->

      <!-- Main Lower Industrial Chassis Body (Clean White/Alloy) -->
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.60 0.48 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.88 0.90 0.92 1.0</ambient>
          <diffuse>0.92 0.94 0.96 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- Top High-Friction Deck / Cargo Platform (Black Textured Rubber Pad) -->
      <visual name="top_platform">
        <pose>0 0 0.095 0 0 0</pose>
        <geometry>
          <box>
            <size>0.56 0.46 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.12 1.0</ambient>
          <diffuse>0.15 0.15 0.18 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>

      <!-- Perimeter Protective Safety Bumper Skirt (Dark Anthracite) -->
      <visual name="safety_bumper">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.61 0.50 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.15 1.0</ambient>
          <diffuse>0.18 0.18 0.22 1.0</diffuse>
        </material>
      </visual>

      <!-- Front Status / Directional LED Light Bar -->
      <visual name="front_status_led">
        <pose>0.298 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.32 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.75 1.0 1.0</ambient>
          <diffuse>0.1 0.85 1.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Rear Safety Braking LED Indicator -->
      <visual name="rear_status_led">
        <pose>-0.298 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.32 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1.0</ambient>
          <diffuse>1.0 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <!-- Side Branding / Identification Stripe -->
      <visual name="left_brand_stripe">
        <pose>0 0.242 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.40 0.005 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.9 1.0</ambient>
          <diffuse>0.2 0.6 1.0 1.0</diffuse>
        </material>
      </visual>
      <visual name="right_brand_stripe">
        <pose>0 -0.242 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.40 0.005 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.5 0.9 1.0</ambient>
          <diffuse>0.2 0.6 1.0 1.0</diffuse>
        </material>
      </visual>

      <!-- IMU SENSOR -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <topic>imu</topic>
      </sensor>

      <!-- CONTACT SENSOR FOR ZERO-COLLISION EVALUATION -->
      <sensor name="chassis_contact_sensor" type="contact">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <contact>
          <collision>chassis_collision</collision>
        </contact>
        <topic>amr_contact</topic>
      </sensor>
    </link>

    <!-- ============================= -->
    <!-- LEFT DRIVE WHEEL              -->
    <!-- Radius: 0.10m, Width: 0.05m   -->
    <!-- ============================= -->
    <link name="left_wheel">
      <pose>0 0.25 0.10 -1.57079632679 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00406</ixx>
          <iyy>0.00406</iyy>
          <izz>0.0075</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1.0</ambient>
          <diffuse>0.22 0.22 0.25 1.0</diffuse>
        </material>
      </visual>
      <!-- Rim Center Hubcap -->
      <visual name="hubcap">
        <pose>0 0 0.026 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ============================= -->
    <!-- RIGHT DRIVE WHEEL             -->
    <!-- Radius: 0.10m, Width: 0.05m   -->
    <!-- ============================= -->
    <link name="right_wheel">
      <pose>0 -0.25 0.10 -1.57079632679 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00406</ixx>
          <iyy>0.00406</iyy>
          <izz>0.0075</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1.0</ambient>
          <diffuse>0.22 0.22 0.25 1.0</diffuse>
        </material>
      </visual>
      <!-- Rim Center Hubcap -->
      <visual name="hubcap">
        <pose>0 0 -0.026 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ============================= -->
    <!-- LEFT WHEEL JOINT              -->
    <!-- ============================= -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ============================= -->
    <!-- RIGHT WHEEL JOINT             -->
    <!-- ============================= -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ============================= -->
    <!-- CASTER WHEEL                  -->
    <!-- ============================= -->
    <link name="caster">
      <pose>-0.20 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
              <slip1>1.0</slip1>
              <slip2>1.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.05</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
    </link>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <!-- ============================= -->
    <!-- 2D PLANAR LIDAR SCANNER       -->
    <!-- ============================= -->
    <link name="lidar_link">
      <pose>0.14 0 0.26 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Cylindrical Sensor Housing with Protective Shield -->
      <visual name="lidar_housing">
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.10 1.0</ambient>
          <diffuse>0.12 0.12 0.15 1.0</diffuse>
        </material>
      </visual>
      <visual name="lidar_scanner_eye">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.055</radius>
            <length>0.045</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="lidar_2d" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <topic>scan</topic>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ============================= -->
    <!-- DIFFERENTIAL DRIVE PLUGIN     -->
    <!-- ============================= -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>
  </model>
</sdf>
